# AWS Region (Note: ACM Certificate for CloudFront is automatically provisioned in us-east-1)
aws_region = "us-east-1"

# Project Identifier
project_name = "rahul-patil-portfolio"

# Environment
environment = "prod"

# Custom Domain Configuration (Route 53 Hosted Zone + ACM SSL/TLS)
domain_name          = "therahulpatil.in"
enable_custom_domain = true

# Set to true if you want to also provision an AWS Amplify App via Terraform
enable_amplify = false

# GitHub repository details (used if enable_amplify is true)
github_repository   = "https://github.com/therahulpatil/AWS-SWAG-Portfolio"
github_access_token = ""

# Resource Tags
tags = {
  Project     = "AWS-SWAG-Portfolio"
  Owner       = "Rahul Patil"
  Role        = "DevOps Engineer Associate"
  Company     = "HeapTrace Technologies"
  ManagedBy   = "Terraform"
  Environment = "Production"
  Domain      = "therahulpatil.in"
}
